# PostgreSQL connection used by the app
DATABASE_URL=postgresql+asyncpg://tachafy_app:your_password@localhost:5432/tachafy_teleconsult
# PostgreSQL connection used by Alembic for migrations
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://postgres:your-superuser-password@localhost/tachafy_teleconsult

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your_dev_key
LIVEKIT_API_SECRET=your_dev_secret

# Database field-level encryption (required — the app will not start without these)
# Generate each with: openssl rand -base64 32
# These two keys must NOT be the same value as each other.
DATABASE_ENCRYPTION_KEY=<generate_with_openssl_rand_-base64_32>
DATABASE_BLIND_INDEX_KEY=<generate_with_openssl_rand_-base64_32>

# E2EE key derivation for LiveKit media encryption
# Generate with: openssl rand -base64 32
# Must be DIFFERENT values from DATABASE_ENCRYPTION_KEY and DATABASE_BLIND_INDEX_KEY — do not reuse either.
E2EE_MASTER_SECRET_V1=<generate_with_openssl_rand_-base64_32>
E2EE_CURRENT_KEY_VERSION=1
